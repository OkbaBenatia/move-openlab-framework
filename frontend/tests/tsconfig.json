{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": false,
    "strict": true,
    "noUnusedLocals": true,
    "outDir": "../.unit-tests",
    "rootDir": "..",
    "skipLibCheck": true
  },
  "include": [
    "./**/*.test.ts",
    "./node-shim.d.ts"
  ]
}
