{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OkbaBenatia/move-openlab-framework/schemas/vehicle-profile.schema.json",
  "title": "MOVE OpenLab vehicle profile",
  "description": "A vehicle a driver drives, with every energy and emission parameter as an editable, documented record. Presets, researcher profiles and the profiles frozen inside instances share this shape. No value is defaulted: an absent parameter makes the emission computation incomplete.",
  "type": "object",
  "required": ["id", "name", "powertrain", "parameters"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"},
    "name": {"type": "string", "maxLength": 80},
    "category": {"type": "string", "maxLength": 40, "default": "car"},
    "passenger_capacity": {"type": "integer", "minimum": 1, "maximum": 60, "description": "Passenger seats (the driver excluded)."},
    "powertrain": {"enum": ["ICE", "HEV", "PHEV", "BEV", "custom"]},
    "energy": {"type": "string", "maxLength": 40, "description": "Fuel or energy type, e.g. petrol, diesel, electricity."},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fuel_consumption_l_100km": {"$ref": "#/$defs/record"},
        "electricity_consumption_kwh_100km": {"$ref": "#/$defs/record"},
        "fuel_emission_factor_g_per_l": {"$ref": "#/$defs/factor"},
        "electricity_emission_factor_g_per_kwh": {"$ref": "#/$defs/factor"},
        "direct_co2_g_per_km": {"$ref": "#/$defs/factor"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["preset", "researcher", "imported", "demo"]},
        "preset_id": {"type": "string"}, "preset_version": {"type": "string"}, "default": {"type": "boolean"},
        "derived_from": {"type": "string"}, "notes": {"type": "string"}
      }
    },
    "version": {"type": "integer", "minimum": 1, "description": "Bumped by the store on every edit."},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string"},
        "source": {"type": "string", "maxLength": 300, "description": "Publisher and document the value comes from, or the statement that it is the researcher's assumption."},
        "source_version": {"type": "string", "maxLength": 80, "description": "Edition, year or version of the source."},
        "applicability": {"type": "string", "maxLength": 120, "description": "Geographic or technical applicability."},
        "notes": {"type": "string", "maxLength": 400},
        "recorded_at": {"type": "string", "description": "When the value was entered or changed."}
      }
    },
    "factor": {
      "allOf": [{"$ref": "#/$defs/record"}, {"properties": {"basis": {"enum": ["CO2", "CO2e"], "default": "CO2"}}}]
    }
  }
}
